  }
  var prompt = readPrompts_()[Number(kind)];
  if (!prompt) {
    throw new Error("找不到這個自訂提示，請重新整理頁面");
  }
  return { name: prompt.name, text: callGroq_(selection + "\n\n" + prompt.prompt, false).trim() };
