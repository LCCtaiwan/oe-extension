// JSON that is safe inside <script>: no "</script>", no JS line separators.
function safeJson_(value) {
  return JSON.stringify(value)
    .replace(/</g, "\\u003c")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
